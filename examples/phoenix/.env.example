# Copy to .env, fill in, then load it into your shell with: set -a; . ./.env; set +a
# .env is ignored by git. Never commit a server key.

# Required. The site's server key, shown once when you make it on the site's Sites page.
# A practice site's key starts siwa_sk_test_, a live site's siwa_sk_live_.
SIWA_SERVER_KEY=

# Required. The site's handle, as its Sites page shows it.
SIWA_HANDLE=

# Optional. The SIWA service this site asks. Defaults to https://siwa.regents.sh.
SIWA_SERVICE=

# Optional. A live site's token from its Sites page, served at /.well-known/siwa-site.txt.
# A practice site needs none.
SIWA_SITE_TOKEN=

# Production only. The site's public host name, such as demo.example.com.
PHX_HOST=

# Optional. The port to listen on. Defaults to 4000.
PORT=
