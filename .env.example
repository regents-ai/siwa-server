# Copy this file to .env.local for local work, then run: direnv allow
# Keep real values in .env.local or Fly secrets. Do not commit them.
# An empty value uses the default README.md lists for it.

export DATABASE_URL=ecto://postgres:postgres@localhost/siwa_server_dev
export SECRET_KEY_BASE=
export PHX_HOST=127.0.0.1
export PORT=4100

# Shared SIWA receipt signing
export SIWA_RECEIPT_SECRET=
export SIWA_NONCE_TTL_SECONDS=300
export SIWA_RECEIPT_TTL_SECONDS=3600
export SIWA_HTTP_SIGNATURE_TOLERANCE_SECONDS=300
# Optional: approved audience=origin pairs for EOA wallet sign-in, comma separated.
# Example: patchbay=https://patchbay.help,keyfleet=https://keyfleet.example
# Empty disables wallet sign-in for every audience. Run locally, an audience may also
# list its local site, such as keyfleet=http://localhost:4000, so requests signed for it
# are accepted there; production never accepts one.
export SIWA_WALLET_ORIGINS=

# Sites allowed to read verified-request activity, each with its own key:
# regents=<key>,patchbay=<key>,keyfleet=<key> (keys of 32+ letters, digits, - or _)
export SIWA_ACTIVITY_READERS=

# Sites allowed to ask for hosted signing, each with its own key, in the same shape:
# patchbay=<key>. Empty lets no site sign.
export SIWA_HOSTED_SIGNERS=

# Hello cards: one or two Ed25519 keys, comma separated, each 32 random bytes as
# unpadded base64url. The first signs new cards; both are published at
# /.well-known/jwks.json, so a second keeps older cards checkable while keys change.
# Empty turns hello cards off; everything else still runs.
export SIWA_CARD_KEYS=

# Replay cleanup
export SIWA_CLEANUP_BATCH_SIZE=1000

# Base mainnet RPC for agent owner checks and Base smart-wallet sign-in
export BASE_RPC_URL=

# Ethereum mainnet RPC for Ethereum smart-wallet sign-in
export ETHEREUM_RPC_URL=

# World Chain RPC for reading World's AgentBook
export WORLD_RPC_URL=

# The password hosted connections' keys are encrypted with in the database.
export KEYSTORE_PASSWORD=

# The control API (/api/control/v1), where a person signed in with Privy manages their
# customer, sites and site keys. Both are public values. Either empty turns the control
# API off; everything else still runs.
export PRIVY_APP_ID=
# Privy's ES256 verification PUBLIC key, not the Privy app secret: the PEM exactly as
# Privy shows it, with real line breaks. Example shape:
# export PRIVY_VERIFICATION_KEY='-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----'
export PRIVY_VERIFICATION_KEY=

# Billing through Stripe: subscribing, usage reporting and invoices. Any one empty turns
# billing off; everything else still runs. `mix siwa_server.stripe_setup` prints the
# price id and meter event name for the account the key opens.
export STRIPE_SECRET_KEY=
# The signing secret of the Stripe webhook endpoint that sends to /api/stripe/webhook.
export STRIPE_WEBHOOK_SECRET=
export STRIPE_PRICE_ID=
export STRIPE_METER_EVENT_NAME=
# Origins a person may come back to from Stripe's pages, https:// only, comma separated.
# Example: https://regents.sh
export SIWA_PORTAL_ORIGINS=
# Off production only, instead of STRIPE_SECRET_KEY: the path of a file holding a Stripe
# test-mode key (sk_test_ or rk_test_). The file's contents never go in this file.
# export STRIPE_TEST_KEY_FILE=

# Production only, never exported locally. fly.toml sets PHX_SERVER and ECTO_IPV6;
# its release command alone sets SIWA_RELEASE_COMMAND. DNS_CLUSTER_QUERY stays unset:
# the machines share only the database.
# export PHX_SERVER=true
# export ECTO_IPV6=true
# export SIWA_RELEASE_COMMAND=migrate
# export DNS_CLUSTER_QUERY=
