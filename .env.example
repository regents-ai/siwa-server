# Copy this file to .env.local for local work, then run: direnv allow
# Keep real values in .env.local or Fly secrets. Do not commit them.
# An empty value uses the default README.md lists for it.

export DATABASE_URL=ecto://postgres:postgres@localhost/siwa_server_dev
export SECRET_KEY_BASE=
export PHX_HOST=127.0.0.1
export PORT=4100

# Shared SIWA receipt signing
export SIWA_RECEIPT_SECRET=
export SIWA_NONCE_TTL_SECONDS=300
export SIWA_RECEIPT_TTL_SECONDS=3600
export SIWA_HTTP_SIGNATURE_TOLERANCE_SECONDS=300
# Optional: approved audience=origin pairs for EOA wallet sign-in, comma separated.
# Example: patchbay=https://patchbay.help,keyfleet=https://keyfleet.example
# Empty disables wallet sign-in for every audience.
export SIWA_WALLET_ORIGINS=

# Sites allowed to read verified-request activity, each with its own key:
# regents=<key>,patchbay=<key>,keyfleet=<key> (keys of 32+ letters, digits, - or _)
export SIWA_ACTIVITY_READERS=

# Sites allowed to ask for hosted signing, each with its own key, in the same shape:
# patchbay=<key>. Empty lets no site sign.
export SIWA_HOSTED_SIGNERS=

# Replay cleanup
export SIWA_CLEANUP_BATCH_SIZE=1000

# Base mainnet RPC for agent owner checks and Base smart-wallet sign-in
export BASE_RPC_URL=

# Ethereum mainnet RPC for Ethereum smart-wallet sign-in
export ETHEREUM_RPC_URL=

# World Chain RPC for reading World's AgentBook
export WORLD_RPC_URL=

# Encrypted key store for hosted signing. encrypted_file is the only backend.
# An empty path uses /tmp/siwa-server-keystore.bin locally; production uses
# /data/siwa-server-keystore.bin on the siwa_data volume.
export KEYSTORE_PASSWORD=
export KEYSTORE_BACKEND=encrypted_file
export KEYSTORE_PATH=

# Production only, read by the release and set by fly.toml, never locally:
# PHX_SERVER=true starts the web server, ECTO_IPV6=true reaches the database over
# IPv6, and SIWA_RELEASE_COMMAND=migrate is set by the release command alone.
# DNS_CLUSTER_QUERY stays unset: the service runs as exactly one machine.
